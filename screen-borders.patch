+#include <algorithm>
 #include <unordered_map>
 #include <wil/com.h>
 
@@ -777,6 +778,47 @@ void CreateGraphicsTab(UIState* state)
     ImGui::TreePop();
   }
 
+  if (ImGui::TreeNode("Screen Borders"))
+  {
+    auto draw_margin_control = [](const char* label, const char* id,
+                                  const Config::Info<float>& setting) {
+      float value = std::clamp(Config::Get(setting), 0.0f, 25.0f);
+      ImGui::PushID(id);
+      if (ImGui::Button("-"))
+      {
+        value = std::max(0.0f, value - 0.5f);
+        Config::SetBaseOrCurrent(setting, value);
+        Config::Save();
+      }
+      ImGui::SameLine();
+      if (ImGui::Button("+"))
+      {
+        value = std::min(25.0f, value + 0.5f);
+        Config::SetBaseOrCurrent(setting, value);
+        Config::Save();
+      }
+      ImGui::SameLine();
+      ImGui::Text("%s: %.1f%%", label, value);
+      ImGui::PopID();
+    };
+
+    draw_margin_control("Top Margin", "margin_top", Config::GFX_SCREEN_MARGIN_TOP);
+    draw_margin_control("Bottom Margin", "margin_bottom", Config::GFX_SCREEN_MARGIN_BOTTOM);
+    draw_margin_control("Left Margin", "margin_left", Config::GFX_SCREEN_MARGIN_LEFT);
+    draw_margin_control("Right Margin", "margin_right", Config::GFX_SCREEN_MARGIN_RIGHT);
+
+    if (ImGui::Button("Reset Screen Borders"))
+    {
+      Config::SetBaseOrCurrent(Config::GFX_SCREEN_MARGIN_TOP, 0.0f);
+      Config::SetBaseOrCurrent(Config::GFX_SCREEN_MARGIN_BOTTOM, 0.0f);
+      Config::SetBaseOrCurrent(Config::GFX_SCREEN_MARGIN_LEFT, 0.0f);
+      Config::SetBaseOrCurrent(Config::GFX_SCREEN_MARGIN_RIGHT, 0.0f);
+      Config::Save();
+    }
+
+    ImGui::TreePop();
+  }
